# =============================================================================
# EARTH JUKEBOX — Production Environment Configuration Template
# NASA Space Apps Challenge 2026
#
# INSTRUCTIONS:
# 1. Copy this file to .env:
#    cp .env.example .env
# 2. Populate values with your production deployment hosts and credentials.
# 3. NEVER commit your actual .env file or real secrets to Git!
# =============================================================================

# -----------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT & NETWORKING
# -----------------------------------------------------------------------------
ENVIRONMENT=production
DEBUG=false
HOST=0.0.0.0
PORT=8000

# -----------------------------------------------------------------------------
# 2. CORS TRUSTED ORIGINS
# Comma-separated allowlist of origins permitted to communicate with the API.
# Add your production Vercel frontend URL here (e.g. https://your-project.vercel.app).
# -----------------------------------------------------------------------------
CORS_ORIGINS=https://earth-information-jukebox.vercel.app,http://localhost:5173

# -----------------------------------------------------------------------------
# 3. AUTHENTICATION & CRYPTOGRAPHIC SECRETS
# In production, generate a high-entropy secret with at least 32 characters:
# python -c "import secrets; print(secrets.token_hex(32))"
# -----------------------------------------------------------------------------
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# -----------------------------------------------------------------------------
# 4. RATE LIMITING (Sliding Window per IP per Minute)
# -----------------------------------------------------------------------------
RATE_LIMIT_DEFAULT_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=15
RATE_LIMIT_COMPUTE_PER_MINUTE=30

# -----------------------------------------------------------------------------
# 5. REQUEST & PAYLOAD SIZE LIMITS (Bytes)
# -----------------------------------------------------------------------------
MAX_REQUEST_BODY_SIZE_BYTES=16777216   # 16 MB max for multipart file uploads
MAX_JSON_BODY_SIZE_BYTES=1048576       # 1 MB max for standard JSON requests

# -----------------------------------------------------------------------------
# 6. EXTERNAL HTTP TIMEOUTS (Seconds)
# -----------------------------------------------------------------------------
EXTERNAL_REQUEST_TIMEOUT_SECONDS=10.0
EXTERNAL_CONNECT_TIMEOUT_SECONDS=5.0

# -----------------------------------------------------------------------------
# 7. NASA OPEN APIS & SATELLITE IMAGERY SERVICES
# NASA GIBS WMTS endpoints are public and do not require API keys.
# Optional NASA Open API Key (obtain from https://api.nasa.gov):
# -----------------------------------------------------------------------------
NASA_GIBS_BASE_URL=https://gibs.earthdata.nasa.gov
NASA_API_KEY=DEMO_KEY

# -----------------------------------------------------------------------------
# 8. COPERNICUS DATA SPACE ECOSYSTEM (CDSE) / SENTINEL-2 (Optional)
# Free registration at https://dataspace.copernicus.eu for STAC client credentials:
# -----------------------------------------------------------------------------
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
COPERNICUS_AUTH_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
COPERNICUS_CATALOGUE_URL=https://catalogue.dataspace.copernicus.eu/resto/api/collections/Sentinel2/search.json
SENTINEL_STAC_API_URL=https://earth-search.aws.element84.com/v1

# -----------------------------------------------------------------------------
# 9. FRONTEND ENVIRONMENT CONFIGURATION (Vercel Project Settings)
# When deploying to Vercel, set VITE_API_BASE_URL to your deployed backend URL.
# Local development default: /api/v1 (proxied by Vite)
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=https://your-backend-api.onrender.com/api/v1
