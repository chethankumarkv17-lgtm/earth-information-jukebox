# EARTH JUKEBOX Backend Configuration — NASA Space Apps Challenge 2026
ENVIRONMENT=development
DEBUG=True
HOST=127.0.0.1
PORT=8000

# CORS Trusted Frontend Allowlist (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Authentication & Cryptographic Security
# In production, configure a high-entropy secret with at least 32 characters
JWT_SECRET=earth-jukebox-spaceapps-super-secure-jwt-secret-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# Rate Limiting (Requests per minute per IP)
RATE_LIMIT_DEFAULT_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=15
RATE_LIMIT_COMPUTE_PER_MINUTE=30

# Request Size Limits (Bytes)
MAX_REQUEST_BODY_SIZE_BYTES=16777216   # 16 MB max for multipart file uploads
MAX_JSON_BODY_SIZE_BYTES=1048576       # 1 MB max for standard JSON requests

# External HTTP Request Timeouts (Seconds)
EXTERNAL_REQUEST_TIMEOUT_SECONDS=10.0
EXTERNAL_CONNECT_TIMEOUT_SECONDS=5.0

# NASA Open APIs & GIBS (Global Imagery Browse Services)
NASA_GIBS_BASE_URL=https://gibs.earthdata.nasa.gov
NASA_API_KEY=DEMO_KEY

# Copernicus Data Space Ecosystem (CDSE) / Sentinel-2 Credentials
# Register at https://dataspace.copernicus.eu for free OAuth2 client credentials
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
COPERNICUS_AUTH_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
COPERNICUS_CATALOGUE_URL=https://catalogue.dataspace.copernicus.eu/resto/api/collections/Sentinel2/search.json
SENTINEL_STAC_API_URL=https://earth-search.aws.element84.com/v1

# In-Memory Geospatial Tile & Analysis Cache
CACHE_TTL_SECONDS=3600
CACHE_MAX_ENTRIES=500

# Optional Supabase Integration
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_JWT_SECRET=
